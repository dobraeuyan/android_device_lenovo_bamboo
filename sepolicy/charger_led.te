type vendor_charger_led, domain;
type vendor_charger_led_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_charger_led)

allow vendor_charger_led sysfs_leds:dir r_dir_perms;
allow vendor_charger_led sysfs_leds:file rw_file_perms;
allow vendor_charger_led sysfs_leds:lnk_file read;

allow vendor_charger_led sysfs_battery_supply:dir r_dir_perms;
allow vendor_charger_led sysfs_battery_supply:file r_file_perms;
allow vendor_charger_led sysfs_battery_supply:lnk_file read;

allow vendor_charger_led self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
